{
  "info": {
    "name": "BDF Lab 03 - Books REST API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Success and failure test cases for Lab 3. Set baseUrl to local or deployed URL, then run the collection (Runner)."
  },
  "item": [
    {
      "name": "01 Setup",
      "item": [
        {
          "name": "Health: API is running",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/",
              "host": [
                "{{baseUrl}}"
              ],
              "path": []
            },
            "description": ""
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "02 Success cases",
      "item": [
        {
          "name": "S1 List books (defaults)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/books",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "books"
              ]
            },
            "description": ""
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
                  "const j=pm.response.json();",
                  "pm.test(\"Defaults limit=10 offset=0\", () => { pm.expect(j.limit).to.eql(10); pm.expect(j.offset).to.eql(0); });",
                  "pm.test(\"data is an array\", () => pm.expect(j.data).to.be.an(\"array\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "S2 Search by title (search_q=java)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/books?search_q=java",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "books"
              ],
              "query": [
                {
                  "key": "search_q",
                  "value": "java"
                }
              ]
            },
            "description": ""
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"All titles contain java\", () => pm.response.json().data.forEach(b => pm.expect(b.title.toLowerCase()).to.include(\"java\")));"
                ]
              }
            }
          ]
        },
        {
          "name": "S3 Sort by price DESC",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/books?order_by=price&order=DESC",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "books"
              ],
              "query": [
                {
                  "key": "order_by",
                  "value": "price"
                },
                {
                  "key": "order",
                  "value": "DESC"
                }
              ]
            },
            "description": ""
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Prices descending\", () => { const p = pm.response.json().data.map(b => b.price); pm.expect(p).to.eql([...p].sort((a,b)=>b-a)); });"
                ]
              }
            }
          ]
        },
        {
          "name": "S4 Pagination (limit=3, offset=2)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/books?limit=3&offset=2&order_by=id",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "books"
              ],
              "query": [
                {
                  "key": "limit",
                  "value": "3"
                },
                {
                  "key": "offset",
                  "value": "2"
                },
                {
                  "key": "order_by",
                  "value": "id"
                }
              ]
            },
            "description": ""
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"3 records returned\", () => pm.expect(pm.response.json().count).to.eql(3));"
                ]
              }
            }
          ]
        },
        {
          "name": "S5 Price range (300 to 500)",
          "request": {
